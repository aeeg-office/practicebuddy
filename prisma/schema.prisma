generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  domain              String?              @unique
  isActive            Boolean              @default(true)
  config              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  accessCodes         AccessCode[]
  assignments         Assignment[]
  classes             Class[]
  courses             Course[]
  enrollments         Enrollment[]
  exams               Exam[]
  generation_metadata GenerationMetadata[]
  goldQuestions       GoldQuestion[]
  live_sessions       LiveSession[]
  microSkills         MicroSkill[]
  practiceSessions    PracticeSession[]
  programs            Program[]
  questionFamilies    QuestionFamily[]
  questionVersions    QuestionVersion[]
  questions           Question[]
  schools             School[]
  studentAttempts     StudentAttempt[]
  subjects            Subject[]
  teachers            Teacher[]
  userSkillMasteries  UserSkillMastery[]
  users               User[]

  @@map("tenants")
}

model User {
  id                 String                 @id @default(cuid())
  tenantId           String
  email              String                 @unique
  name               String?
  passwordHash       String?
  role               String                 @default("student")
  isActive           Boolean                @default(true)
  imageUrl           String?
  lastLoginAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  accessRedemptions  AccessCodeRedemption[]
  assignments        Assignment[]
  enrollments        Enrollment[]
  payments           Payment[]
  practiceSessions   PracticeSession[]
  studentAssignments StudentAssignment[]
  studentAttempts    StudentAttempt[]
  teacher            Teacher?
  skillMasteries     UserSkillMastery[]
  tenant             Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("users")
}

model Teacher {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String   @unique
  bio       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("teachers")
}

model AccessCode {
  id          String                 @id @default(cuid())
  tenantId    String
  code        String                 @unique
  role        String                 @default("student")
  maxUses     Int                    @default(1)
  useCount    Int                    @default(0)
  expiresAt   DateTime?
  isActive    Boolean                @default(true)
  createdBy   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  redemptions AccessCodeRedemption[]
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])

  @@map("access_codes")
}

model AccessCodeRedemption {
  id           String     @id @default(cuid())
  accessCodeId String
  userId       String
  redeemedAt   DateTime   @default(now())
  ipAddress    String?
  accessCode   AccessCode @relation(fields: [accessCodeId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([accessCodeId, userId])
  @@map("access_code_redemptions")
}

model Program {
  id          String       @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  grades      Grade[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  questions   Question[]

  @@unique([tenantId, code])
  @@map("programs")
}

model Grade {
  id        String   @id @default(cuid())
  programId String
  level     Int
  label     String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program  @relation(fields: [programId], references: [id])
  skills    Skill[]

  @@unique([programId, level])
  @@map("grades")
}

model Skill {
  id                                                  String             @id @default(cuid())
  gradeId                                             String
  code                                                String
  name                                                String
  description                                         String?
  subject                                             String
  domain                                              String
  category                                            String?
  subcategory                                         String?
  difficulty                                          String             @default("medium")
  isActive                                            Boolean            @default(true)
  order                                               Int                @default(0)
  lesson                                              String?
  strategy                                            String?
  commonMistakes                                      String?
  createdAt                                           DateTime           @default(now())
  updatedAt                                           DateTime           @updatedAt
  assignmentItems                                     AssignmentItem[]
  microSkills                                         MicroSkill[]
  questions                                           Question[]
  skill_mappings                                      SkillMapping[]
  skill_prereqs_skill_prereqs_prereq_skill_idToskills SkillPrereq[]      @relation("skill_prereqs_prereq_skill_idToskills")
  skill_prereqs_skill_prereqs_skill_idToskills        SkillPrereq[]      @relation("skill_prereqs_skill_idToskills")
  grade                                               Grade              @relation(fields: [gradeId], references: [id])
  studentAttempts                                     StudentAttempt[]
  skillMasteries                                      UserSkillMastery[]

  @@unique([gradeId, code])
  @@map("skills")
}

model GoldQuestion {
  id                String           @id @default(cuid())
  tenantId          String
  externalId        String?
  subject           String
  domain            String
  category          String?
  subcategory       String?
  difficulty        String           @default("medium")
  format            String           @default("multiple-choice")
  passage           String?
  stem              String
  options           String?
  correctAnswer     String
  acceptedResponses String?
  explanation       String?
  skillCode         String?
  tags              String?
  hash              String           @unique
  goldStatus        String           @default("certified")
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  microSkillId      String?
  microSkill        MicroSkill?      @relation(fields: [microSkillId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  families          QuestionFamily[]
  derivedQuestions  Question[]

  @@index([tenantId, goldStatus])
  @@map("gold_questions")
}

model QuestionFamily {
  id             String       @id @default(cuid())
  tenantId       String
  goldQuestionId String
  name           String
  description    String?
  variationCount Int          @default(0)
  difficulty     String       @default("medium")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  goldQuestion   GoldQuestion @relation(fields: [goldQuestionId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  questions      Question[]

  @@index([tenantId, goldQuestionId])
  @@map("question_families")
}

model Question {
  id                  String               @id @default(cuid())
  tenantId            String
  goldQuestionId      String?
  familyId            String?
  skillId             String?
  programId           String?
  externalId          String?
  subject             String
  domain              String
  category            String?
  subcategory         String?
  difficulty          String               @default("medium")
  format              String               @default("multiple-choice")
  passage             String?
  stem                String
  options             String?
  correctAnswer       String
  acceptedResponses   String?
  explanation         String?
  hash                String
  questionStatus      String               @default("active")
  version             Int                  @default(1)
  parentVersionId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  qualityStatus       String               @default("draft")
  isActive            Boolean              @default(true)
  calculatorAllowed   Boolean?             @default(false)
  estimatedTime       Int?
  figureUrl           String?
  hint                String?
  rightsStatus        String               @default("original")
  source              String?
  strategy            String?
  microSkillId        String?
  assignmentItems     AssignmentItem[]
  generation_metadata GenerationMetadata[]
  versions            QuestionVersion[]
  family              QuestionFamily?      @relation(fields: [familyId], references: [id])
  goldQuestion        GoldQuestion?        @relation(fields: [goldQuestionId], references: [id])
  microSkill          MicroSkill?          @relation(fields: [microSkillId], references: [id])
  program             Program?             @relation(fields: [programId], references: [id])
  skill               Skill?               @relation(fields: [skillId], references: [id])
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  studentAttempts     StudentAttempt[]
  validation_results  ValidationResult[]

  @@index([tenantId, skillId])
  @@index([hash])
  @@index([subject, questionStatus, isActive])
  @@map("questions")
}

model QuestionVersion {
  id                                                                       String           @id @default(cuid())
  tenantId                                                                 String
  questionId                                                               String
  versionNumber                                                            Int
  stem                                                                     String
  options                                                                  String?
  correctAnswer                                                            String
  explanation                                                              String?
  strategy                                                                 String?
  questionType                                                             String           @default("multiple-choice")
  difficulty                                                               String           @default("medium")
  format                                                                   String           @default("multiple-choice")
  passage                                                                  String?
  acceptedResponses                                                        String?
  qualityStatus                                                            String           @default("draft")
  contentHash                                                              String
  createdBy                                                                String?
  publishedAt                                                              DateTime?
  createdAt                                                                DateTime         @default(now())
  question                                                                 Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tenant                                                                   Tenant           @relation(fields: [tenantId], references: [id])
  studentAttempts                                                          StudentAttempt[]
  student_attempts_student_attempts_question_version_idToquestion_versions StudentAttempt[] @relation("student_attempts_question_version_idToquestion_versions")

  @@unique([questionId, versionNumber])
  @@index([questionId])
  @@index([tenantId])
  @@map("question_versions")
}

model MicroSkill {
  id                                                                     String             @id @default(cuid())
  tenantId                                                               String
  skillId                                                                String
  code                                                                   String
  name                                                                   String
  description                                                            String?
  learningObjective                                                      String?
  difficulty                                                             String             @default("medium")
  order                                                                  Int                @default(0)
  isActive                                                               Boolean            @default(true)
  createdAt                                                              DateTime           @default(now())
  updatedAt                                                              DateTime           @updatedAt
  assignmentItems                                                        AssignmentItem[]
  goldQuestions                                                          GoldQuestion[]
  skill                                                                  Skill              @relation(fields: [skillId], references: [id])
  tenant                                                                 Tenant             @relation(fields: [tenantId], references: [id])
  questions                                                              Question[]
  studentAttempts                                                        StudentAttempt[]
  student_attempts_student_attempts_micro_skill_idTomicro_skills         StudentAttempt[]   @relation("student_attempts_micro_skill_idTomicro_skills")
  skillMasteries                                                         UserSkillMastery[]
  user_skill_masteries_user_skill_masteries_micro_skill_idTomicro_skills UserSkillMastery[] @relation("user_skill_masteries_micro_skill_idTomicro_skills")

  @@unique([tenantId, skillId, code])
  @@index([tenantId, skillId])
  @@map("micro_skills")
}

model Assignment {
  id                 String              @id @default(cuid())
  tenantId           String
  teacherId          String
  classId            String?
  courseId           String?
  title              String
  description        String?
  programId          String?
  dueAt              DateTime?
  totalQuestions     Int                 @default(0)
  mode               String              @default("independent")
  status             String              @default("draft")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              AssignmentItem[]
  course             Course?             @relation(fields: [courseId], references: [id])
  program            Program?            @relation(fields: [programId], references: [id])
  teacher            User                @relation(fields: [teacherId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  studentAssignments StudentAssignment[]

  @@index([tenantId, teacherId])
  @@map("assignments")
}

model AssignmentItem {
  id           String      @id @default(cuid())
  assignmentId String
  skillId      String?
  microSkillId String?
  questionId   String?
  seq          Int         @default(1)
  createdAt    DateTime    @default(now())
  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  microSkill   MicroSkill? @relation(fields: [microSkillId], references: [id])
  question     Question?   @relation(fields: [questionId], references: [id])
  skill        Skill?      @relation(fields: [skillId], references: [id])

  @@index([assignmentId])
  @@map("assignment_items")
}

model StudentAssignment {
  id             String     @id @default(cuid())
  assignmentId   String
  studentId      String
  status         String     @default("assigned")
  startedAt      DateTime?
  completedAt    DateTime?
  score          Int?
  totalQuestions Int        @default(0)
  correctCount   Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
  @@map("student_assignments")
}

model StudentAttempt {
  id                                                                        String           @id @default(cuid())
  tenantId                                                                  String
  userId                                                                    String
  questionId                                                                String
  skillId                                                                   String?
  sessionId                                                                 String?
  answer                                                                    String
  isCorrect                                                                 Boolean
  timeSpent                                                                 Int?
  hintsUsed                                                                 Int              @default(0)
  attemptNumber                                                             Int              @default(1)
  snapshotHash                                                              String
  ipAddress                                                                 String?
  userAgent                                                                 String?
  createdAt                                                                 DateTime         @default(now())
  microSkillId                                                              String?
  questionVersionId                                                         String?
  micro_skill_id                                                            String?
  question_version_id                                                       String?
  snapshot_hash                                                             String?
  ip_address                                                                String?
  user_agent                                                                String?
  hints_used                                                                Int?             @default(0)
  attempt_number                                                            Int?             @default(1)
  microSkill                                                                MicroSkill?      @relation(fields: [microSkillId], references: [id])
  micro_skills_student_attempts_micro_skill_idTomicro_skills                MicroSkill?      @relation("student_attempts_micro_skill_idTomicro_skills", fields: [micro_skill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question                                                                  Question         @relation(fields: [questionId], references: [id])
  questionVersion                                                           QuestionVersion? @relation(fields: [questionVersionId], references: [id])
  question_versions_student_attempts_question_version_idToquestion_versions QuestionVersion? @relation("student_attempts_question_version_idToquestion_versions", fields: [question_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session                                                                   PracticeSession? @relation(fields: [sessionId], references: [id])
  skill                                                                     Skill?           @relation(fields: [skillId], references: [id])
  tenant                                                                    Tenant           @relation(fields: [tenantId], references: [id])
  user                                                                      User             @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, skillId])
  @@index([sessionId])
  @@index([questionVersionId])
  @@index([question_version_id], map: "idx_student_attempts_question_version")
  @@index([userId, questionId])
  @@index([tenantId, userId, skillId, createdAt])
  @@map("student_attempts")
}

model PracticeSession {
  id             String           @id @default(cuid())
  tenantId       String
  userId         String
  type           String
  status         String           @default("in-progress")
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  totalQuestions Int              @default(0)
  correctCount   Int              @default(0)
  totalTimeSpent Int?
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  attempts       StudentAttempt[]

  @@index([tenantId, userId, status])
  @@map("practice_sessions")
}

model UserSkillMastery {
  id                                                             String      @id @default(cuid())
  tenantId                                                       String
  userId                                                         String
  skillId                                                        String
  level                                                          String      @default("not-assessed")
  confidence                                                     Float?
  attemptsCount                                                  Int         @default(0)
  correctCount                                                   Int         @default(0)
  lastAttemptAt                                                  DateTime?
  createdAt                                                      DateTime    @default(now())
  updatedAt                                                      DateTime    @updatedAt
  microSkillId                                                   String?
  micro_skill_id                                                 String?
  microSkill                                                     MicroSkill? @relation(fields: [microSkillId], references: [id])
  micro_skills_user_skill_masteries_micro_skill_idTomicro_skills MicroSkill? @relation("user_skill_masteries_micro_skill_idTomicro_skills", fields: [micro_skill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skill                                                          Skill       @relation(fields: [skillId], references: [id])
  tenant                                                         Tenant      @relation(fields: [tenantId], references: [id])
  user                                                           User        @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, skillId])
  @@map("user_skill_masteries")
}

model Course {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  code        String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  enrollments Enrollment[]
  exams       Exam[]

  @@unique([tenantId, code])
  @@map("courses")
}

model Enrollment {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  courseId   String
  role       String    @default("student")
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  class_id   String?
  classes    Class?    @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course     Course    @relation(fields: [courseId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, courseId])
  @@map("enrollments")
}

model Exam {
  id           String   @id @default(cuid())
  tenantId     String
  courseId     String?
  title        String
  description  String?
  type         String
  duration     Int?
  totalMarks   Int?
  passingMarks Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course?  @relation(fields: [courseId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@map("exams")
}

model School {
  id         String    @id @default(cuid())
  tenant_id  String
  name       String
  code       String?
  address    String?
  phone      String?
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  classes    Class[]
  tenants    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, name])
  @@map("schools")
}

model Class {
  id          String       @id @default(cuid())
  tenant_id   String
  school_id   String?
  name        String
  subject     String?
  grade       String?
  teacher_id  String?
  is_active   Boolean?     @default(true)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @default(now()) @db.Timestamptz(6)
  schools     School?      @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants     Tenant       @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments Enrollment[]

  @@unique([tenant_id, name])
  @@map("classes")
}

model Subject {
  id         String    @id @default(cuid())
  tenant_id  String
  code       String
  name       String
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  tenants    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, code])
  @@map("subjects")
}

model SkillPrereq {
  id                                           String @id @default(cuid())
  skill_id                                     String
  prereq_skill_id                              String
  skills_skill_prereqs_prereq_skill_idToskills Skill  @relation("skill_prereqs_prereq_skill_idToskills", fields: [prereq_skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skills_skill_prereqs_skill_idToskills        Skill  @relation("skill_prereqs_skill_idToskills", fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([skill_id, prereq_skill_id])
  @@map("skill_prereqs")
}

model Standard {
  id             String         @id @default(cuid())
  framework      String
  standard_id    String
  description    String
  grade_band     String?
  subject        String?
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  skill_mappings SkillMapping[]

  @@unique([framework, standard_id])
  @@map("standards")
}

model SkillMapping {
  id          String    @id @default(cuid())
  skill_id    String
  standard_id String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  skills      Skill     @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  standards   Standard  @relation(fields: [standard_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([skill_id, standard_id])
  @@map("skill_mappings")
}

model LiveSession {
  id                  String             @id @default(cuid())
  tenant_id           String
  teacher_id          String
  class_id            String?
  status              String?            @default("active")
  source_skill_id     String?
  current_question_id String?
  started_at          DateTime?          @default(now()) @db.Timestamptz(6)
  ended_at            DateTime?          @db.Timestamptz(6)
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?          @default(now()) @db.Timestamptz(6)
  tenants             Tenant             @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_live_states StudentLiveState[]

  @@index([tenant_id, status], map: "idx_live_sessions_tenant_status")
  @@map("live_sessions")
}

model StudentLiveState {
  id                  String      @id @default(cuid())
  live_session_id     String
  student_id          String
  current_question_id String?
  response_status     String?     @default("awaiting")
  live_sessions       LiveSession @relation(fields: [live_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([live_session_id, student_id])
  @@map("student_live_states")
}

model GenerationMetadata {
  id            String    @id @default(cuid())
  tenant_id     String
  question_id   String?
  job_id        String?
  model         String
  prompt        String?
  temperature   Float?
  tokens_used   Int?
  cost          Float?
  status        String?   @default("generated")
  error_message String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  questions     Question? @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants       Tenant    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, status], map: "idx_gen_metadata_tenant_status")
  @@map("generation_metadata")
}

model ValidationResult {
  id          String    @id @default(cuid())
  question_id String
  validator   String
  status      String
  checks      String?
  details     String?
  score       Float?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  questions   Question  @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id, validator], map: "idx_validation_question_validator")
  @@map("validation_results")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String             @unique
  description   String?
  price         Decimal            @default(0)
  currency      String             @default("EGP")
  interval      String             @default("monthly")
  isActive      Boolean            @default(true)
  features      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String           @id @default(cuid())
  userId             String
  planId             String
  status             String           @default("active")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([userId, planId])
  @@index([userId, status])
  @@map("user_subscriptions")
}

model Payment {
  id                 String    @id @default(cuid())
  userId             String
  subscriptionPlanId String?
  amount             Decimal
  currency           String    @default("EGP")
  status             String    @default("pending")
  paymentMethod      String?
  transactionId      String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@map("payments")
}

model AdminAuditEvent {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, entity])
  @@map("admin_audit_events")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}
